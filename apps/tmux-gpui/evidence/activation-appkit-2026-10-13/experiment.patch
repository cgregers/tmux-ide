+//! PRIVATE EXPERIMENT. Compiled only with integration-test; no focus behavior changes.
+use std::{
+    fs::OpenOptions,
+    io::{self, Write},
+    os::unix::fs::OpenOptionsExt,
+    path::Path,
+    sync::{
+        Mutex, OnceLock,
+        atomic::{AtomicUsize, Ordering},
+        mpsc,
+    },
+    time::{Duration, Instant},
+};
+#[derive(Clone, Copy, PartialEq, Eq, serde::Serialize)]
+pub(super) struct Sample {
+    pub app_active: Option<bool>,
+    pub key_window: Option<bool>,
+    pub guards: u16,
+    pub queued_revision: u64,
+    pub acknowledged_revision: u64,
+    pub window_active: bool,
+    pub presence_active: bool,
+    pub presence_ready: bool,
+    pub request: u64,
+    pub wire_request: u64,
+    pub presence_revision: u64,
+}
+enum Message {
+    Sample(u8, u128, Option<Sample>),
+    Finish(mpsc::SyncSender<()>),
+}
+struct Trace {
+    sender: mpsc::SyncSender<Message>,
+    attempted: AtomicUsize,
+    dropped: AtomicUsize,
+    render: Mutex<Option<Sample>>,
+}
+static TRACE: OnceLock<Trace> = OnceLock::new();
+pub(super) fn initialize() -> io::Result<()> {
+    let Some(path) = std::env::var_os("TMUX_GPUI_ACTIVATION_TRACE") else {
+        return Ok(());
+    };
+    let path = Path::new(&path);
+    if !path.is_absolute() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "absolute trace required",
+        ));
+    }
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(path)?;
+    let (sender, receiver) = mpsc::sync_channel::<Message>(128);
+    std::thread::Builder::new().name("private-activation-trace".into()).spawn(move || {
+        let started = Instant::now();
+        for message in receiver {
+            match message {
+                Message::Sample(stage, sampled_unix_ms, sample) => {
+                    let Ok(fields) = serde_json::to_string(&sample) else { break; };
+                    let dropped = TRACE.get().map_or(0, |t| t.dropped.load(Ordering::Relaxed));
+                    if writeln!(file, "{{\"stage\":{stage},\"sampled_unix_ms\":{sampled_unix_ms},\"elapsed_ms\":{},\"dropped\":{dropped},\"sample\":{fields}}}", started.elapsed().as_millis()).is_err() { break; }
+                }
+                Message::Finish(done) => {
+                    let dropped = TRACE.get().map_or(0, |t| t.dropped.load(Ordering::Relaxed));
+                    if writeln!(file, "{{\"stage\":11,\"dropped\":{dropped}}}")
+                        .and_then(|_| file.flush())
+                        .is_ok()
+                    {
+                        let _ = done.send(());
+                    }
+                    break;
+                }
+            }
+        }
+    })?;
+    TRACE
+        .set(Trace {
+            sender,
+            attempted: AtomicUsize::new(0),
+            dropped: AtomicUsize::new(0),
+            render: Mutex::new(None),
+        })
+        .map_err(|_| io::Error::other("trace already initialized"))?;
+    event(0, None);
+    Ok(())
+}
+pub(super) fn event(stage: u8, sample: Option<Sample>) {
+    let Some(trace) = TRACE.get() else {
+        return;
+    };
+    if stage == 6 {
+        let Ok(mut last) = trace.render.try_lock() else {
+            trace.dropped.fetch_add(1, Ordering::Relaxed);
+            return;
+        };
+        if *last == sample {
+            return;
+        }
+        *last = sample;
+    }
+    if trace.attempted.fetch_add(1, Ordering::Relaxed) >= 512
+        || trace
+            .sender
+            .try_send(Message::Sample(
+                stage,
+                std::time::SystemTime::now()
+                    .duration_since(std::time::UNIX_EPOCH)
+                    .map_or(0, |d| d.as_millis()),
+                sample,
+            ))
+            .is_err()
+    {
+        trace.dropped.fetch_add(1, Ordering::Relaxed);
+    }
+}
+/// After the application loop has exited, never from a UI callback.
+pub(super) fn finish() {
+    if let Some(trace) = TRACE.get() {
+        let (sender, receiver) = mpsc::sync_channel(1);
+        if trace.sender.try_send(Message::Finish(sender)).is_err()
+            || receiver.recv_timeout(Duration::from_secs(2)).is_err()
+        {
+            eprintln!("Private activation trace incomplete");
+        }
+    }
+}
+
+pub(super) fn enabled() -> bool {
+    TRACE.get().is_some()
+}
+/// Borrow AppKit state only on the UI thread; no Objective-C pointer leaves this call.
+pub(super) fn appkit(window: &gpui::Window) -> (Option<bool>, Option<bool>) {
+    use objc2::{MainThreadMarker, rc::Retained};
+    use objc2_app_kit::{NSApplication, NSView};
+    use wry::raw_window_handle::{HasWindowHandle, RawWindowHandle};
+    let Some(mtm) = MainThreadMarker::new() else {
+        return (None, None);
+    };
+    let app = Some(NSApplication::sharedApplication(mtm).isActive());
+    let Ok(handle) = HasWindowHandle::window_handle(window) else {
+        return (app, None);
+    };
+    let RawWindowHandle::AppKit(handle) = handle.as_raw() else {
+        return (app, None);
+    };
+    // SAFETY: GPUI lends its live NSView on the main thread. Retaining it for this
+    // scope matches glass/macos.rs; view/window references are dropped before return.
+    #[allow(unsafe_code)]
+    let view = unsafe { Retained::retain(handle.ns_view.as_ptr().cast::<NSView>()) };
+    let key = view
+        .and_then(|view| view.window())
+        .map(|window| window.isKeyWindow());
+    (app, key)
+}
